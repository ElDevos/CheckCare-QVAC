# CheckCare runs entirely offline after setup — no AI API keys are needed or
# supported for the primary flow. These variables are all optional local
# configuration.

# Port the Edge Runtime (apps/edge) listens on, bound to 127.0.0.1 only.
CHECKCARE_EDGE_PORT=4111

# Base URL apps/web uses to reach the Edge Runtime. Must match
# CHECKCARE_EDGE_PORT above if you change it. Also update the CORS allowlist
# in apps/edge/src/api/server.ts if you change the web app's own port.
NEXT_PUBLIC_EDGE_URL=http://127.0.0.1:4111
